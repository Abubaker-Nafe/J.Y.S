# REQUIRED: PostgreSQL connection. Copy this file to .env and replace placeholders.
DATABASE_URL="postgresql://JYS_USER:JYS_PASSWORD@localhost:5432/jys?schema=public"

# REQUIRED: at least 32 random bytes. Generate on Windows with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OPTIONAL in development; required before production password-reset email is enabled.
EMAIL_PROVIDER="console"
EMAIL_FROM_NAME="JYS"
EMAIL_FROM_ADDRESS="no-reply@example.com"
RESEND_API_KEY=""

# Image storage: the shipped adapter writes to public/uploads. In production,
# mount that exact path on persistent shared storage. The ImageStorage interface
# is the extension point for a future object-storage adapter.
IMAGE_STORAGE_DRIVER="local"
MAX_IMAGE_SIZE_MB="5"

# Seed credentials are development-only. Always override before running a production seed.
SEED_ADMIN_EMAIL="admin@jys.local"
SEED_ADMIN_PASSWORD="ChangeMe-Admin-2026!"
SEED_CUSTOMER_EMAIL="customer@jys.local"
SEED_CUSTOMER_PASSWORD="ChangeMe-Customer-2026!"

# Optional operational settings.
TRUST_PROXY="false"
LOG_LEVEL="info"
